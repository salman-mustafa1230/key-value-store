APP_NAME="Versioned Key Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=keystore
DB_USERNAME=keystore
DB_PASSWORD=keystore
# Railway: set DB_URL to ${{Postgres.DATABASE_URL}} (or DATABASE_URL).
# DB_URL=
DB_SSLMODE=prefer
DB_APPLICATION_NAME=key-value-store
DB_POOL_SIZE=15
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TX_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_PGBOUNCER=false
DB_PERSISTENT=false

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

KEYSTORE_MAX_KEYS_PER_WRITE=10
KEYSTORE_LIST_DEFAULT_LIMIT=50
KEYSTORE_LIST_MAX_LIMIT=1000

L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=
